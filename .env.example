AI_AGENT_API_URL=https://esbst.goteborg.se/citiverse/chat
AI_AGENT_USERNAME=
AI_AGENT_PASSWORD=
AI_AGENT_LANGUAGE=en
AI_AGENT_DISCONNECT_GRACE=300

NUCLEUS_SERVER=omniverse://10.1.116.242
NUCLEUS_USERNAME=
NUCLEUS_PASSWORD=

# Spatial-sound media folder (relative to kit-app-template-main/source/data/).
# Substituted into `iconConfig.soundsDir` for `icon_spatial_sound` in interactions.json.
# Web side does NOT need a matching var — the `@nucleus-sounds/**` Vite glob
# (vite.config.ts) recursively discovers every file under `nucleus/sounds/` and
# resolves URLs by basename, so it's automatically in sync regardless of
# subfolder layout. Move files → update only this one variable.
NUCLEUS_SPATIAL_SOUNDS_FOLDER=nucleus/sounds/spatial/

CESIUM_ION_TOKEN=

# WAQI / air-quality dev IoT (browser). Vite loads .env from repo root (see web-viewer vite.config envDir).
# https://aqicn.org/data-platform/token/
VITE_WAQI_TOKEN=

# Optional: override GBFS root for Styr & Ställ bike-share dev IoT (default is nextbike_zg).
# VITE_GBFS_BIKE_URL=https://api.nextbike.net/maps/gbfs/v1/nextbike_zg/gbfs.json

# --- Live transit overlay (Kit streaming dev) — Västtrafik Planera Resa v4 /positions only ---
# VASTTRAFIK_CLIENT_ID / VASTTRAFIK_CLIENT_SECRET from developer.vasttrafik.se
# Subscribe the OAuth application to "Travel Planner v4" or GET /positions returns 403 (900908).
VASTTRAFIK_CLIENT_ID=
VASTTRAFIK_CLIENT_SECRET=
# Optional: VASTTRAFIK_PLANERA_BASE, TRANSIT_LIVE_* (radius, poll, OSM, dev list, …) — see .cursor/rules/topics/transit-live-overlay.mdc
# Regenerate OSM graph after railway import: from kit-app-template-main/source/data/osm run: python generate_roads.py --force
# OSM_FORCE_REFETCH=1 also forces a fresh Overpass download (ignores osm_cache.json)
# TRANSIT_LIVE_OSM_ROUTE_MODE_TRAM=tram  (default) — Dijkstra on track graph; =car to debug road-snapping
# TRANSIT_LIVE_BUS_USD_PATH=Assets/Bus/bus_edited.usd
# TRANSIT_LIVE_TRAM_USD_PATH=Assets/Tram/tram.usd
