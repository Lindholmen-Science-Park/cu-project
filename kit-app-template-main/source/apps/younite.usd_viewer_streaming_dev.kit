#
# Developer streaming app: inherits everything from younite.usd_viewer_streaming_base.kit,
# then adds dev/CU-only extensions. Production entry: younite.usd_viewer_streaming_prod.kit.

[package]
title = "Younite USD Viewer Streaming"
version = "0.1.0"
description = "Streaming application for Younite USD content (developer feature set)"
keywords = ["experience", "app", "streaming"]
template_name = "omni.usd_viewer"

# Extension search paths — Kit needs these BEFORE resolving [dependencies],
# so the base .kit (a single-file extension in apps/) can be discovered.
[settings.app.exts]
folders.'++' = [
    "${app}/../exts",
    "${app}/../extensions",
    "${app}/../apps",
    "${app}/../extscache",
    "${kit}/exts",
    "${kit}/extscache"
]

[settings.app.extensions]
registryEnabled = true
supportedTargets.platform = []

[dependencies]
"younite.usd_viewer_streaming_base" = {}
# --- Dev / experimental only (not loaded in production) ---
# Cesium disabled until Kit 110-compatible build is available (C++ ABI break: OpenUSD 25.11 + Carbonite 210)
# "cesium.usd.plugins" = {}
# "cesium.omniverse" = {}
"younite.maintenance_bot_extension" = { order = 1220 }
"younite.incident_extension" = { order = 1210 }
"younite.geo_poi_extension" = { order = 1200 }
"younite.open_data_live_extension" = { order = 1205 }
"younite.ai_chat_extension" = { order = 1200 }
"younite.ai_agent_extension" = { order = 1200 }
"younite.camera_data_visualization_extension" = { order = 1200 }
"younite.camera_depth_extension" = { order = 1200 }
"younite.sound_area_extension" = { order = 1200 }
"younite.osm_navigation_extension" = { order = 1210 }
"younite.navmesh_dev_overlays_extension" = { order = 1215 }
"younite.camera_placement_extension" = { order = 1200 }
"younite.viewport_capture_extension" = { order = 1200 }
"younite.usd_edit_extension" = { order = 1200 }

[settings.app]
name = "Younite USD Viewer Streaming (Dev)"

[settings.app.window]
title = "Younite USD Viewer Streaming (Dev)"

# Cesium disabled until Kit 110-compatible build is available
# [settings.exts."cesium.omniverse"]
# showOnStartup = false
# showCreditsOnScreen = false

[template]
type = "ApplicationLayerTemplate"




