#usda 1.0
(
    defaultPrim = "MaintenanceBotModel"
    doc = "Placeholder maintenance bot model. Replace this file with a proper model asset."
)

def Xform "MaintenanceBotModel"
{
    def Capsule "Body"
    {
        double height = 120
        double radius = 30
        token axis = "Y"
        color3f[] primvars:displayColor = [(0.2, 0.6, 1.0)]
    }

    def Sphere "Head"
    {
        double radius = 20
        double3 xformOp:translate = (0, 100, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.1, 0.4, 0.9)]
    }
}
