            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                asset info:mdl:sourceAsset = @OmniPBR.mdl@
                token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.2651297, 0.26512703, 0.26512703)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.3
                token outputs:out
            }
        }

        def Material "VIS_Svartgeneric"
        {
            token outputs:mdl:displacement.connect = </World/Looks/VIS_Svartgeneric/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/VIS_Svartgeneric/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/VIS_Svartgeneric/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                asset info:mdl:sourceAsset = @OmniPBR.mdl@
                token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.011527244, 0.0115273595, 0.011527244)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.29
                token outputs:out
            }
        }

        def Material "HighlightMaterial"
        {
            token outputs:mdl:displacement.connect = </World/Looks/HighlightMaterial/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/HighlightMaterial/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/HighlightMaterial/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                asset info:mdl:sourceAsset = @OmniPBR.mdl@
                token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.2, 0.9, 0.3)
                color3f inputs:emissive_color = (0.2, 1, 0.3)
                float inputs:emissive_intensity = 5000
                bool inputs:enable_emission = 1
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.4
                token outputs:out
            }
        }
    }

