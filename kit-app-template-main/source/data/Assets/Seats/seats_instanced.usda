#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.001
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "VIS_Orangeplastic"
        {
            token outputs:mdl:displacement.connect = </World/Looks/VIS_Orangeplastic/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/VIS_Orangeplastic/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/VIS_Orangeplastic/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                asset info:mdl:sourceAsset = @OmniPBR.mdl@
                token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.44956774, 0.20138972, 0.111420244)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.28
                token outputs:out
            }
        }

        def Material "VIS_Whiteplastic"
        {
            token outputs:mdl:displacement.connect = </World/Looks/VIS_Whiteplastic/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/VIS_Whiteplastic/Shader.outputs:out>
