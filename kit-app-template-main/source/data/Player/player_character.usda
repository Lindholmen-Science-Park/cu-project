#usda 1.0
(
    defaultPrim = "PlayerCharacter"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Capsule "PlayerCharacter" (
    prepend apiSchemas = ["PhysxCharacterControllerAPI"]
)
{
    uniform token axis = "Y"
    float3[] extent = [(-10, -11, -10), (10, 11, 10)]
    double height = 2
    float physxCharacterController:stepOffset = 40
    uniform token physxCharacterController:upAxis = "Y"
    double radius = 10
    custom bool refinementEnableOverride = 1
    custom int refinementLevel = 2
    double3 xformOp:scale = (1, 1, 1)
    uniform token[] xformOpOrder = ["xformOp:scale"]

    def "first_person_camera" (
        prepend references = @../cameras/player/first_person_camera.usda@
    )
    {
    }
}

