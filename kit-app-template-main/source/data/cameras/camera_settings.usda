#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/PlayerCharacter/first_person_camera"
        }
    }
    defaultPrim = "RenderSettings"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def "RenderSettings" (
    kind = "component"
)
{
    # This layer overrides the camera settings to use Player camera for streaming
    # The boundCamera setting in customLayerData will override the default perspective camera
}
