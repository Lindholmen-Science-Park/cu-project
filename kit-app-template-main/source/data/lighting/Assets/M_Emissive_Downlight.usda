#usda 1.0
(
    defaultPrim = "M_Emissive_Downlight"
    upAxis = "Z"
)

def Material "M_Emissive_Downlight"
{
    token outputs:surface.connect = </M_Emissive_Downlight/SurfaceShader.outputs:surface>
    token outputs:unreal:surface.connect = </M_Emissive_Downlight/UnrealShader.outputs:out>

    def Shader "UnrealShader"
    {
        uniform token info:implementationSource = "sourceAsset"
        uniform asset info:unreal:sourceAsset = @/Game/4_Materials/Emissive/M_Emissive_Downlight.M_Emissive_Downlight@
        token outputs:out
    }

    def Shader "SurfaceShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        float inputs:anisotropy = 0
        color3f inputs:diffuseColor = (0, 0, 0)
        color3f inputs:emissiveColor = (10, 8.4375, 7.5234375)
        float inputs:metallic = 0
        normal3f inputs:normal = (0.49803925, -0.49803925, 1)
        float inputs:occlusion = 1
        float inputs:roughness = 0
        float inputs:specular = 0.49803925
        normal3f inputs:tangent = (1, -0.49803925, 0.49803925)
        token outputs:surface
    }
}

