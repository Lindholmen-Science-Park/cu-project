#usda 1.0

over "World"
{
    def Xform "video_trigger_01"
    {
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-1568.081298828125, 2261.800048828125, -3561.569580078125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def Cube "Collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            float3 xformOp:scale = (50, 120, 50)
            double3 xformOp:translate = (0, 60, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            token visibility = "invisible"
            bool physics:collisionEnabled = 1
        }
    }
}

